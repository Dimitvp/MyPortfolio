@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section id="about">
    <div class="row">
        <div class="twelve columns main-col">
            <h2>Something went wrong.</h2>
            <p>An error occurred while processing your request. <a href="/">Back to the home page</a></p>
            @if (Model.ShowRequestId)
            {
                <p>Request ID: <code>@Model.RequestId</code></p>
            }
        </div>
    </div>
</section>
